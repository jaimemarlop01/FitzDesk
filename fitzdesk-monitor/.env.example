# Clave de API de Groq — obtener en https://console.groq.com
GROQ_API_KEY=gsk_...

# Ruta a la carpeta de artículos del proyecto Astro (relativa o absoluta)
ASTRO_CONTENT_PATH=../src/content/articulos

# Intervalo de comprobación en horas (por defecto 24)
CHECK_INTERVAL_HOURS=24

# Webhook de Discord (opcional) — dejar vacío para desactivar
DISCORD_WEBHOOK_URL=

# Webhook de Slack (opcional) — dejar vacío para desactivar
SLACK_WEBHOOK_URL=
