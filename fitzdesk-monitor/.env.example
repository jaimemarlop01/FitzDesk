# ── API de generación de borradores (Groq — gratuito) ──
# Obtener en https://console.groq.com
GROQ_API_KEY=gsk_...

# ── API de verificación de relevancia (Gemini — opcional) ──
# Sin esta clave solo se usa el filtro de palabras clave (Capa 1)
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── Rutas del proyecto Astro ──
# Ruta a los artículos (relativa a fitzdesk-monitor/)
ASTRO_CONTENT_PATH=../src/content/articulos
# Ruta donde guardar imágenes descargadas de productos
ASTRO_IMAGES_PATH=../public/images/borradores

# ── Programación ──
# Horas entre comprobaciones en modo daemon (por defecto 24)
CHECK_INTERVAL_HOURS=24
# Hora del resumen diario en modo daemon (formato 24h, por defecto 9)
DAILY_SUMMARY_HOUR=9

# ── Notificaciones ──
# Webhook de Discord — dejar vacío para desactivar
DISCORD_WEBHOOK_URL=
