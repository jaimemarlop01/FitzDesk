---
import { u, base } from '../lib/url';

const nav = [
  { label: 'Ratones',    href: u('/categoria/ratones') },
  { label: 'Teclados',   href: u('/categoria/teclados') },
  { label: 'Monitores',  href: u('/categoria/monitores') },
  { label: 'Portátiles', href: u('/categoria/portatiles') },
  { label: 'Setups',     href: u('/categoria/setups') },
  { label: 'Guías',      href: u('/categoria/guias') },
  { label: 'About',      href: u('/about') },
];

const currentPath = Astro.url.pathname;
const buscarUrl = u('/buscar');
---

<header class="site-header">
  <div class="container header-inner">
    <a href={base} class="logo" aria-label="FitzDesk - Inicio">
      <svg class="logo-icon" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="40" height="40" rx="8" fill="#F97316"/>
        <circle cx="20" cy="20" r="11" fill="#DEB887"/>
        <ellipse cx="12" cy="11" rx="4" ry="5.5" fill="#CD853F"/>
        <ellipse cx="28" cy="11" rx="4" ry="5.5" fill="#CD853F"/>
        <ellipse cx="12" cy="11.5" rx="2.5" ry="3.5" fill="#F4A460"/>
        <ellipse cx="28" cy="11.5" rx="2.5" ry="3.5" fill="#F4A460"/>
        <ellipse cx="20" cy="22" rx="7" ry="6" fill="#F4A460"/>
        <circle cx="16" cy="19" r="2.8" fill="white"/>
        <circle cx="24" cy="19" r="2.8" fill="white"/>
        <circle cx="16.5" cy="19" r="1.4" fill="#1a1a1a"/>
        <circle cx="24.5" cy="19" r="1.4" fill="#1a1a1a"/>
        <circle cx="17.2" cy="18.2" r="0.5" fill="white"/>
        <circle cx="25.2" cy="18.2" r="0.5" fill="white"/>
        <rect x="11.5" y="16.5" width="8" height="5.5" rx="2" fill="none" stroke="#3d2b1f" stroke-width="1.2"/>
        <rect x="20.5" y="16.5" width="8" height="5.5" rx="2" fill="none" stroke="#3d2b1f" stroke-width="1.2"/>
        <line x1="19.5" y1="19.25" x2="20.5" y2="19.25" stroke="#3d2b1f" stroke-width="1.2"/>
        <ellipse cx="20" cy="24" rx="1.5" ry="1" fill="#8B4513"/>
        <polygon points="16.5,29 20,27 23.5,29 20,31" fill="#DC2626"/>
        <circle cx="20" cy="29" r="1.5" fill="#EF4444"/>
      </svg>
      <span class="logo-text">Fitz<em>Desk</em></span>
    </a>

    <div class="header-right">
      <!-- Inline search bar (hidden by default) -->
      <div class="header-search" id="header-search" aria-expanded="false">
        <form
          action={buscarUrl}
          method="get"
          role="search"
          class="header-search-form"
          aria-label="Búsqueda rápida"
        >
          <label for="header-search-input" class="sr-only">Búsqueda rápida</label>
          <svg class="hs-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          <input
            id="header-search-input"
            name="q"
            type="search"
            placeholder="Buscar artículos..."
            autocomplete="off"
            aria-label="Buscar artículos"
          />
          <button type="button" id="close-search" aria-label="Cerrar búsqueda">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Search toggle button -->
      <button class="search-toggle" id="search-toggle" aria-label="Abrir buscador" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </button>

      <button class="nav-toggle" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="main-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
      <ul>
        {nav.map(item => (
          <li>
            <a
              href={item.href}
              class={currentPath.startsWith(item.href) ? 'active' : ''}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Nav toggle
  const navToggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const mainNav = document.querySelector('.main-nav');

  navToggle?.addEventListener('click', () => {
    const expanded = navToggle.getAttribute('aria-expanded') === 'true';
    navToggle.setAttribute('aria-expanded', String(!expanded));
    mainNav?.classList.toggle('is-open');
  });

  document.addEventListener('click', (e) => {
    if (!navToggle?.contains(e.target as Node) && !mainNav?.contains(e.target as Node)) {
      navToggle?.setAttribute('aria-expanded', 'false');
      mainNav?.classList.remove('is-open');
    }
  });

  // Search toggle
  const searchToggle = document.getElementById('search-toggle') as HTMLButtonElement;
  const headerSearch = document.getElementById('header-search') as HTMLElement;
  const headerInput = document.getElementById('header-search-input') as HTMLInputElement;
  const closeSearch = document.getElementById('close-search') as HTMLButtonElement;

  function openSearch() {
    headerSearch.setAttribute('aria-expanded', 'true');
    searchToggle.setAttribute('aria-expanded', 'true');
    searchToggle.style.display = 'none';
    headerInput.focus();
  }

  function closeSearchBar() {
    headerSearch.setAttribute('aria-expanded', 'false');
    searchToggle.setAttribute('aria-expanded', 'false');
    searchToggle.style.display = '';
    headerInput.value = '';
  }

  searchToggle?.addEventListener('click', openSearch);
  closeSearch?.addEventListener('click', closeSearchBar);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && headerSearch.getAttribute('aria-expanded') === 'true') {
      closeSearchBar();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 4rem;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
    color: var(--color-text);
    flex-shrink: 0;
    transition: opacity var(--transition);
  }

  .logo:hover {
    opacity: 0.85;
    text-decoration: none;
    color: var(--color-text);
  }

  .logo-icon { width: 36px; height: 36px; flex-shrink: 0; }

  .logo-text em { color: var(--color-brand); font-style: normal; }

  /* ===== NAV ===== */
  .main-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .main-nav ul {
    display: flex;
    gap: 0.125rem;
    align-items: center;
  }

  .main-nav a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition), background var(--transition);
    white-space: nowrap;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--color-brand);
    background: var(--color-brand-bg);
    text-decoration: none;
  }

  /* ===== HEADER RIGHT ===== */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  /* ===== SEARCH TOGGLE BUTTON ===== */
  .search-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    border-radius: var(--radius);
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
    flex-shrink: 0;
  }

  .search-toggle:hover {
    background: var(--color-brand-bg);
    color: var(--color-brand);
  }

  .search-toggle svg { width: 18px; height: 18px; }

  /* ===== INLINE SEARCH ===== */
  .header-search {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4rem;
    background: white;
    border-bottom: 2px solid var(--color-brand);
    display: none;
    align-items: center;
    padding: 0 1.5rem;
    z-index: 10;
  }

  .header-search[aria-expanded="true"] {
    display: flex;
  }

  .header-search-form {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    gap: 0.75rem;
  }

  .hs-icon {
    width: 18px;
    height: 18px;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  #header-search-input {
    flex: 1;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    border: none;
    background: transparent;
    outline: none;
  }

  #header-search-input::placeholder { color: var(--color-text-muted); }

  #close-search {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: background 0.15s, color 0.15s;
  }

  #close-search:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  #close-search svg { width: 18px; height: 18px; }

  /* ===== NAV TOGGLE (mobile) ===== */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 0.5rem;
    border-radius: var(--radius);
    transition: background var(--transition);
  }

  .nav-toggle:hover { background: var(--color-bg-tertiary); }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: var(--transition);
  }

  /* A11Y */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }

    .main-nav {
      display: none;
      position: absolute;
      top: 4rem;
      left: 0;
      right: 0;
      background: white;
      border-bottom: 1px solid var(--color-border);
      padding: 0.75rem 1.5rem 1rem;
      box-shadow: var(--shadow-md);
      flex: unset;
      justify-content: unset;
    }

    .main-nav.is-open { display: block; }

    .main-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .main-nav a {
      padding: 0.75rem 0.25rem;
      border-radius: 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 1rem;
    }

    .main-nav ul li:last-child a { border-bottom: none; }
  }
</style>
