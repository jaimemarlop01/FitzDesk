---
import { u, base } from '../lib/url';

const year = new Date().getFullYear();

const categorias = [
  { label: 'Ratones',         href: u('/categoria/ratones') },
  { label: 'Teclados',        href: u('/categoria/teclados') },
  { label: 'Monitores',       href: u('/categoria/monitores') },
  { label: 'Portátiles',      href: u('/categoria/portatiles') },
  { label: 'Setups completos', href: u('/categoria/setups') },
  { label: 'Guías',           href: u('/categoria/guias') },
];

const info = [
  { label: 'Buscador',       href: u('/buscar') },
  { label: 'About FitzDesk', href: u('/about') },
  { label: 'Contacto',       href: u('/contacto') },
  { label: 'Privacidad',     href: u('/privacidad') },
  { label: 'Cookies',       href: u('/cookies') },
  { label: 'Aviso legal',   href: u('/aviso-legal') },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={base} class="footer-logo">
          <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="40" height="40" rx="8" fill="#F97316"/>
            <circle cx="20" cy="20" r="11" fill="#DEB887"/>
            <ellipse cx="12" cy="11" rx="4" ry="5.5" fill="#CD853F"/>
            <ellipse cx="28" cy="11" rx="4" ry="5.5" fill="#CD853F"/>
            <ellipse cx="20" cy="22" rx="7" ry="6" fill="#F4A460"/>
            <circle cx="16" cy="19" r="2.8" fill="white"/>
            <circle cx="24" cy="19" r="2.8" fill="white"/>
            <circle cx="16.5" cy="19" r="1.4" fill="#1a1a1a"/>
            <circle cx="24.5" cy="19" r="1.4" fill="#1a1a1a"/>
            <rect x="11.5" y="16.5" width="8" height="5.5" rx="2" fill="none" stroke="#3d2b1f" stroke-width="1.2"/>
            <rect x="20.5" y="16.5" width="8" height="5.5" rx="2" fill="none" stroke="#3d2b1f" stroke-width="1.2"/>
            <line x1="19.5" y1="19.25" x2="20.5" y2="19.25" stroke="#3d2b1f" stroke-width="1.2"/>
            <ellipse cx="20" cy="24" rx="1.5" ry="1" fill="#8B4513"/>
            <polygon points="16.5,29 20,27 23.5,29 20,31" fill="#DC2626"/>
            <circle cx="20" cy="29" r="1.5" fill="#EF4444"/>
          </svg>
          <span>Fitz<em>Desk</em></span>
        </a>
        <p class="footer-tagline">
          Análisis honestos de periféricos y setups para profesionales que trabajan desde casa.
        </p>
      </div>

      <div class="footer-col">
        <h3>Categorías</h3>
        <ul>
          {categorias.map(l => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>Información</h3>
        <ul>
          {info.map(l => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-disclaimer">
      <p>
        <strong>Aviso:</strong> Los precios mostrados son orientativos y pueden variar.
        Nuestras opiniones son siempre independientes.
      </p>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} FitzDesk. Todos los derechos reservados.</p>
      <div class="footer-social">
        <a href="https://www.instagram.com/fitzdesk_" target="_blank" rel="noopener noreferrer" aria-label="FitzDesk en Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61591148423466" target="_blank" rel="noopener noreferrer" aria-label="FitzDesk en Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://www.pinterest.es/fitzdesk" target="_blank" rel="noopener noreferrer" aria-label="FitzDesk en Pinterest">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: var(--color-text-on-dark);
    margin-top: auto;
    padding: 3.5rem 0 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: white;
    margin-bottom: 1rem;
  }

  .footer-logo svg {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
  }

  .footer-logo em {
    color: var(--color-brand);
    font-style: normal;
  }

  .footer-logo:hover {
    text-decoration: none;
    color: white;
    opacity: 0.9;
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-on-dark-muted);
  }

  .footer-col h3 {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    margin-bottom: 1rem;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col a {
    color: var(--color-text-on-dark-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-col a:hover {
    color: var(--color-brand);
    text-decoration: none;
  }

  .footer-disclaimer {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .footer-disclaimer strong {
    color: var(--color-text-on-dark-muted);
  }

  .footer-bottom {
    padding: 1.25rem 0;
    font-size: 0.825rem;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-shrink: 0;
  }

  .footer-social a {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    transition: color var(--transition);
  }

  .footer-social a:hover {
    color: var(--color-primary);
  }

  .footer-social svg {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.75rem;
    }
  }
</style>
