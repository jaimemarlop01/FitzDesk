---
export interface Props {
  quote: string;
}

const { quote } = Astro.props;
---

<aside class="fitz-quote">
  <div class="fitz-avatar">
    <!-- Fitz: ardilla con gafas y pajarita roja -->
    <svg viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Tail (behind) -->
      <path d="M 85 128 Q 108 105 104 78 Q 100 55 84 62 Q 92 78 88 98 Q 86 112 83 126 Z" fill="#A0522D" opacity="0.85"/>
      <!-- Body -->
      <ellipse cx="57" cy="116" rx="22" ry="17" fill="#CD853F"/>
      <!-- Head -->
      <circle cx="57" cy="72" r="26" fill="#DEB887"/>
      <!-- Left ear -->
      <ellipse cx="37" cy="52" rx="9" ry="13" fill="#CD853F"/>
      <ellipse cx="37" cy="53" rx="5.5" ry="8.5" fill="#F4A460"/>
      <!-- Right ear -->
      <ellipse cx="77" cy="52" rx="9" ry="13" fill="#CD853F"/>
      <ellipse cx="77" cy="53" rx="5.5" ry="8.5" fill="#F4A460"/>
      <!-- Face lighter area -->
      <ellipse cx="57" cy="77" rx="17" ry="15" fill="#F4A460"/>
      <!-- Left eye white -->
      <circle cx="47" cy="69" r="7" fill="white"/>
      <!-- Right eye white -->
      <circle cx="67" cy="69" r="7" fill="white"/>
      <!-- Pupils -->
      <circle cx="48" cy="69" r="3.5" fill="#1a1a1a"/>
      <circle cx="68" cy="69" r="3.5" fill="#1a1a1a"/>
      <!-- Eye shine -->
      <circle cx="49.5" cy="67.5" r="1.2" fill="white"/>
      <circle cx="69.5" cy="67.5" r="1.2" fill="white"/>
      <!-- Glasses left frame -->
      <rect x="38.5" y="63.5" width="15" height="10.5" rx="3" fill="none" stroke="#3d2b1f" stroke-width="1.8"/>
      <!-- Glasses right frame -->
      <rect x="56.5" y="63.5" width="15" height="10.5" rx="3" fill="none" stroke="#3d2b1f" stroke-width="1.8"/>
      <!-- Glasses bridge -->
      <line x1="53.5" y1="68.75" x2="56.5" y2="68.75" stroke="#3d2b1f" stroke-width="1.8"/>
      <!-- Glasses left arm -->
      <line x1="38.5" y1="68.75" x2="33" y2="68.75" stroke="#3d2b1f" stroke-width="1.8"/>
      <!-- Glasses right arm -->
      <line x1="71.5" y1="68.75" x2="77" y2="68.75" stroke="#3d2b1f" stroke-width="1.8"/>
      <!-- Nose -->
      <ellipse cx="57" cy="80.5" rx="3" ry="2" fill="#8B4513"/>
      <!-- Smile -->
      <path d="M 51 86 Q 57 91 63 86" stroke="#8B4513" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      <!-- Blush cheeks -->
      <circle cx="39" cy="77" r="5" fill="#f08080" opacity="0.3"/>
      <circle cx="75" cy="77" r="5" fill="#f08080" opacity="0.3"/>
      <!-- Bow tie main -->
      <polygon points="49,100 57,96.5 65,100 57,103.5" fill="#DC2626"/>
      <!-- Bow tie knot -->
      <circle cx="57" cy="100" r="2.8" fill="#EF4444"/>
      <!-- Belly -->
      <ellipse cx="57" cy="118" rx="14" ry="10" fill="#F4A460" opacity="0.55"/>
    </svg>
  </div>

  <div class="fitz-content">
    <div class="fitz-label">
      <strong>Fitz recomienda</strong>
    </div>
    <blockquote class="fitz-text">
      "{quote}"
    </blockquote>
    <cite class="fitz-cite">— Fitz, experto en periféricos</cite>
  </div>
</aside>

<style>
  .fitz-quote {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: var(--color-brand-bg);
    border: 2px solid var(--color-brand-light);
    border-left: 5px solid var(--color-brand);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .fitz-avatar {
    flex-shrink: 0;
  }

  .fitz-avatar svg {
    width: 80px;
    height: 93px;
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.12));
  }

  .fitz-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fitz-label strong {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brand);
    font-weight: 700;
  }

  .fitz-text {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text);
    font-style: italic;
    margin: 0;
    padding: 0;
    border: none;
  }

  .fitz-cite {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-style: normal;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .fitz-quote {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .fitz-avatar svg {
      width: 70px;
      height: 82px;
    }
  }
</style>
