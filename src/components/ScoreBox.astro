---
export interface Props {
  puntuacion: number;
  precio?: string;
}

const { puntuacion, precio } = Astro.props;

const pct = (puntuacion / 10) * 100;

const verdict =
  puntuacion >= 9.5 ? 'Imprescindible' :
  puntuacion >= 9   ? 'Sobresaliente' :
  puntuacion >= 8   ? 'Muy recomendado' :
  puntuacion >= 7   ? 'Buena opción' :
  puntuacion >= 6   ? 'Aceptable' :
  'No recomendado';

const color =
  puntuacion >= 9 ? '#16a34a' :
  puntuacion >= 7.5 ? '#F97316' :
  '#DC2626';
---

<div class="score-box">
  <div class="score-left">
    <div class="score-number" style={`color: ${color}`}>
      {puntuacion}
      <span class="score-max">/10</span>
    </div>
    <div class="score-verdict" style={`color: ${color}`}>{verdict}</div>
  </div>

  <div class="score-right">
    <div class="score-bar-label">Puntuación FitzDesk</div>
    <div class="score-bar-track">
      <div
        class="score-bar-fill"
        style={`width: ${pct}%; background: ${color}`}
        role="progressbar"
        aria-valuenow={puntuacion}
        aria-valuemin={0}
        aria-valuemax={10}
      ></div>
    </div>
    {precio && (
      <div class="score-price">
        Precio orientativo: <strong>{precio}</strong>
      </div>
    )}
  </div>
</div>

<style>
  .score-box {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.5rem 2rem;
  }

  .score-left {
    text-align: center;
    flex-shrink: 0;
  }

  .score-number {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .score-max {
    font-size: 1.25rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .score-verdict {
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .score-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .score-bar-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .score-bar-track {
    height: 12px;
    background: var(--color-border);
    border-radius: 999px;
    overflow: hidden;
  }

  .score-bar-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.6s ease;
  }

  .score-price {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .score-price strong {
    color: var(--color-text);
    font-size: 1rem;
  }

  @media (max-width: 480px) {
    .score-box {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
    }
  }
</style>
