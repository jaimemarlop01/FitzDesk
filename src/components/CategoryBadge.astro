---
export interface Props {
  categoria: string;
  size?: 'sm' | 'md';
}

const { categoria, size = 'sm' } = Astro.props;

const config: Record<string, { label: string; color: string; bg: string }> = {
  ratones:   { label: 'Ratones',   color: '#1D4ED8', bg: '#DBEAFE' },
  teclados:  { label: 'Teclados',  color: '#7C3AED', bg: '#EDE9FE' },
  monitores: { label: 'Monitores', color: '#0D9488', bg: '#CCFBF1' },
  portatiles:{ label: 'Portátiles',color: '#15803D', bg: '#DCFCE7' },
  setups:    { label: 'Setups',    color: '#B45309', bg: '#FEF3C7' },
};

const cat = config[categoria] ?? { label: categoria, color: '#374151', bg: '#F3F4F6' };
---

<span
  class={`category-badge size-${size}`}
  style={`color: ${cat.color}; background: ${cat.bg};`}
>
  {cat.label}
</span>

<style>
  .category-badge {
    display: inline-block;
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .size-sm {
    font-size: 0.7rem;
    padding: 0.25rem 0.5rem;
  }

  .size-md {
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
  }
</style>
