---
import { u } from '../lib/url';
const privacidadUrl = u('/privacidad');
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Aviso de cookies" aria-live="polite" style="display:none">
  <div class="cookie-inner">
    <p class="cookie-text">
      Usamos cookies propias y de terceros (Google Analytics) para analizar el tráfico y mejorar tu experiencia.
      <a href={privacidadUrl} class="cookie-link">Más información</a>
    </p>
    <div class="cookie-actions">
      <button id="cookie-accept-all" class="btn-accept">Aceptar todas</button>
      <button id="cookie-essential" class="btn-essential">Solo esenciales</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY    = 'fitzdesk_cookies_consent';
    var GA_ID  = 'G-JLVZH5G4KT';
    var banner = document.getElementById('cookie-banner');

    // Migrar clave antigua si existe
    var oldKey = localStorage.getItem('fitzdesk_cookies');
    if (oldKey && !localStorage.getItem(KEY)) {
      localStorage.setItem(KEY, oldKey === 'all' ? 'accepted' : oldKey);
      localStorage.removeItem('fitzdesk_cookies');
    }

    function loadAnalytics() {
      if (document.querySelector('script[src*="googletagmanager"]')) return;
      // Actualizar consent (window.gtag ya definido en <head> con Consent Mode v2)
      window.gtag('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
      });
      // Cargar el script de GA e inicializar
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      window.gtag('js', new Date());
      window.gtag('config', GA_ID);
    }

    function dismiss(value) {
      localStorage.setItem(KEY, value);
      if (banner) banner.style.display = 'none';
    }

    var saved = localStorage.getItem(KEY);
    if (saved === 'accepted') {
      loadAnalytics();
    } else if (!saved) {
      if (banner) banner.style.display = 'block';
    }

    var btnAll = document.getElementById('cookie-accept-all');
    var btnEss = document.getElementById('cookie-essential');

    if (btnAll) btnAll.addEventListener('click', function () {
      loadAnalytics();
      dismiss('accepted');
    });

    if (btnEss) btnEss.addEventListener('click', function () {
      dismiss('essential');
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-text);
    color: white;
    z-index: 9999;
    box-shadow: 0 -2px 16px rgba(0,0,0,0.25);
  }

  .cookie-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .cookie-text {
    flex: 1;
    min-width: 200px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: white;
    margin: 0;
  }

  .cookie-link {
    color: white;
    text-decoration: underline;
    margin-left: 0.2rem;
    white-space: nowrap;
  }

  .cookie-link:hover {
    opacity: 0.85;
  }

  .cookie-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-accept {
    background: var(--color-primary);
    color: white;
    border: none;
    padding: 0.55rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .btn-accept:hover { background: var(--color-primary-dark); }

  .btn-essential {
    background: transparent;
    color: white;
    border: 1.5px solid var(--color-border);
    padding: 0.55rem 1.25rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }

  .btn-essential:hover {
    background: rgba(255,255,255,0.08);
    border-color: white;
  }

  @media (max-width: 600px) {
    .cookie-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
    .cookie-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .btn-accept, .btn-essential {
      text-align: center;
    }
  }
</style>
