---
export interface Props {
  href: string;
  precio?: string;
  tienda?: string;
}

const { href, precio, tienda = 'PcComponentes' } = Astro.props;
---

<div class="affiliate-block">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer sponsored"
    class="affiliate-btn"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
      <line x1="3" y1="6" x2="21" y2="6"/>
      <path d="M16 10a4 4 0 01-8 0"/>
    </svg>
    Buscar en {tienda}
    {precio && <span class="btn-price">{precio}</span>}
  </a>
  <p class="affiliate-notice">
    Los precios mostrados son orientativos. Te recomendamos verificar el precio actual antes de comprar.
  </p>
</div>

<style>
  .affiliate-block {
    margin: 2rem 0;
    text-align: center;
  }

  .affiliate-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--color-brand);
    color: white;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    padding: 0.875rem 2rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.35);
  }

  .affiliate-btn:hover {
    background: var(--color-brand-dark);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249, 115, 22, 0.45);
    text-decoration: none;
    color: white;
  }

  .affiliate-btn svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .btn-price {
    background: rgba(255,255,255,0.25);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    margin-left: 0.25rem;
  }

  .affiliate-notice {
    margin-top: 0.75rem;
    font-size: 0.775rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
