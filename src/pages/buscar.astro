---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base, u } from '../lib/url';

const indexUrl = (import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/') + 'search-index.json';

const categories = [
  { label: 'Todos',      value: '' },
  { label: 'Ratones',    value: 'ratones' },
  { label: 'Teclados',   value: 'teclados' },
  { label: 'Monitores',  value: 'monitores' },
  { label: 'Portátiles', value: 'portatiles' },
  { label: 'Setups',     value: 'setups' },
  { label: 'Guías',      value: 'guias' },
];
---

<BaseLayout
  title="Buscador"
  description="Busca análisis de ratones, teclados, monitores y portátiles para teletrabajo en FitzDesk."
>
  <div id="search-app" data-index-url={indexUrl} data-base={base}>

    <!-- Hero search -->
    <section class="search-hero">
      <div class="container search-hero-inner">
        <div class="search-hero-text">
          <h1>¿Qué estás buscando?</h1>
          <p>Encuentra el análisis que necesitas entre todos los productos de FitzDesk</p>
        </div>

        <div class="search-box" role="search">
          <label for="search-input" class="sr-only">Buscar artículos</label>
          <div class="search-input-wrap">
            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.35-4.35"/>
            </svg>
            <input
              id="search-input"
              type="search"
              placeholder="Busca ratones, teclados, monitores..."
              autocomplete="off"
              spellcheck="false"
              aria-label="Buscar artículos en FitzDesk"
            />
            <button id="clear-btn" class="clear-btn" aria-label="Limpiar búsqueda" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Category filters -->
        <div class="category-filters" role="group" aria-label="Filtrar por categoría">
          {categories.map(cat => (
            <button
              class={`filter-btn ${cat.value === '' ? 'active' : ''}`}
              data-cat={cat.value}
              type="button"
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- States area -->
    <section class="search-results-section">
      <div class="container">

        <!-- Estado 1: inicial — todos los artículos, sin Fitz -->
        <div id="state-initial" style="display:none">
          <p class="section-label">Todos los análisis</p>
          <div id="initial-grid" class="articles-grid" role="list"></div>
        </div>

        <!-- Estado 2: resultados de búsqueda o filtro -->
        <div id="state-results" style="display:none">
          <p id="results-meta" class="results-meta" aria-live="polite" aria-atomic="true"></p>
          <div id="results-grid" class="articles-grid" role="list"></div>
        </div>

        <!-- Estado 3: sin resultados — Fitz triste -->
        <div id="state-empty" style="display:none">
          <div class="empty-fitz" aria-hidden="true">
            <svg viewBox="0 0 120 140" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="60" cy="135" rx="35" ry="5" fill="#e5e7eb"/>
              <ellipse cx="60" cy="118" rx="22" ry="17" fill="#CD853F"/>
              <circle cx="60" cy="72" r="28" fill="#DEB887"/>
              <ellipse cx="38" cy="50" rx="10" ry="13" fill="#CD853F"/>
              <ellipse cx="38" cy="50" rx="6" ry="9" fill="#F4A460"/>
              <ellipse cx="82" cy="50" rx="10" ry="13" fill="#CD853F"/>
              <ellipse cx="82" cy="50" rx="6" ry="9" fill="#F4A460"/>
              <ellipse cx="60" cy="78" rx="18" ry="16" fill="#F4A460"/>
              <circle cx="49" cy="67" r="7.5" fill="white"/>
              <circle cx="71" cy="67" r="7.5" fill="white"/>
              <circle cx="51" cy="70" r="3.5" fill="#1a1a1a"/>
              <circle cx="73" cy="70" r="3.5" fill="#1a1a1a"/>
              <circle cx="52" cy="68" r="1.2" fill="white"/>
              <circle cx="74" cy="68" r="1.2" fill="white"/>
              <path d="M 44 60 Q 49 58 54 60" stroke="#8B4513" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              <path d="M 66 60 Q 71 58 76 60" stroke="#8B4513" stroke-width="1.5" fill="none" stroke-linecap="round"/>
              <path d="M 52 84 Q 60 90 68 84" stroke="#8B4513" stroke-width="1.8" fill="none" stroke-linecap="round"/>
              <ellipse cx="42" cy="78" rx="5" ry="5" fill="#f08080" opacity="0.4"/>
              <ellipse cx="78" cy="78" rx="5" ry="5" fill="#f08080" opacity="0.4"/>
              <ellipse cx="41" cy="120" rx="8" ry="12" fill="#CD853F" transform="rotate(-18 41 120)"/>
              <ellipse cx="79" cy="120" rx="8" ry="12" fill="#CD853F" transform="rotate(18 79 120)"/>
            </svg>
          </div>
          <p class="empty-title">Fitz no encuentra nada para <span id="empty-term"></span></p>
          <p class="empty-sub">Prueba con otros términos o explora las categorías</p>
          <div class="empty-cats">
            <a href={u('/categoria/ratones')}>Ratones</a>
            <a href={u('/categoria/teclados')}>Teclados</a>
            <a href={u('/categoria/monitores')}>Monitores</a>
            <a href={u('/categoria/portatiles')}>Portátiles</a>
          </div>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';

  const app      = document.getElementById('search-app') as HTMLElement;
  const indexUrl = app.dataset.indexUrl!;
  const base     = app.dataset.base!;

  const input      = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn   = document.getElementById('clear-btn') as HTMLButtonElement;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  const stInitial  = document.getElementById('state-initial')! as HTMLElement;
  const stResults  = document.getElementById('state-results')! as HTMLElement;
  const stEmpty    = document.getElementById('state-empty')!   as HTMLElement;
  const initialGrid = document.getElementById('initial-grid')!;
  const resultsGrid = document.getElementById('results-grid')!;
  const resultsMeta = document.getElementById('results-meta')!;
  const emptyTerm   = document.getElementById('empty-term')!;

  let allArticles: Article[] = [];
  let fuse: Fuse<Article>;
  let activeCategory = '';

  interface Article {
    title: string;
    slug: string;
    categoria: string;
    descripcion: string;
    puntuacion?: number;
    precio: string;
    imagen: string;
    fecha: string;
    tipo?: string;
  }

  const TIPO_LABELS: Record<string, string> = {
    comparativa: 'Comparativa',
    guia: 'Guía',
    lanzamiento: 'Próximamente',
  };

  function scoreColor(n?: number | null) {
    if (n == null || isNaN(n)) return '#F97316';
    if (n >= 9) return '#16a34a';
    if (n >= 7.5) return '#F97316';
    return '#DC2626';
  }

  function catLabel(cat: string) {
    const map: Record<string, string> = {
      ratones: 'Ratones', teclados: 'Teclados', monitores: 'Monitores',
      portatiles: 'Portátiles', setups: 'Setups', guias: 'Guías de compra',
    };
    return map[cat] ?? cat;
  }

  function highlight(text: string, query: string): string {
    if (!query.trim()) return text;
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return text.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
  }

  function imgUrl(img: string) {
    const clean = img.startsWith('/') ? img.slice(1) : img;
    return base.endsWith('/') ? base + clean : base + '/' + clean;
  }

  function articleUrl(slug: string) {
    return base.endsWith('/') ? base + 'articulo/' + slug : base + '/articulo/' + slug;
  }

  function renderCard(article: Article, query = ''): string {
    const title = highlight(article.title, query);
    const desc  = highlight(article.descripcion, query);

    const hasScore = article.puntuacion != null && !isNaN(Number(article.puntuacion));
    let scoreHtml = '';
    if (hasScore) {
      scoreHtml = `<span class="card-score" style="color:${scoreColor(article.puntuacion)}">${article.puntuacion}/10</span>`;
    } else if (article.tipo && TIPO_LABELS[article.tipo]) {
      scoreHtml = `<span class="card-tipo-badge">${TIPO_LABELS[article.tipo]}</span>`;
    }

    const hasPrice = article.precio && article.precio !== 'pendiente' && article.precio !== 'Ver en PcComponentes';
    const sep       = scoreHtml && hasPrice ? '<span class="card-sep" aria-hidden="true">·</span>' : '';
    const priceHtml = hasPrice ? `<span class="card-price">${article.precio}</span>` : '';

    return `
      <article class="article-card" role="listitem">
        <a href="${articleUrl(article.slug)}" class="card-link">
          <div class="card-img-wrap">
            <img src="${imgUrl(article.imagen)}" alt="${article.title}" loading="lazy" width="400" height="210" />
            <span class="card-badge">${catLabel(article.categoria)}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">${title}</h3>
            <p class="card-desc" style="color:#64748b">${desc}</p>
            <div class="card-footer">
              ${scoreHtml}${sep}${priceHtml}
            </div>
          </div>
        </a>
      </article>`;
  }

  // ── Gestión de estados ────────────────────────
  // Solo display:none / display:block — sin hidden, sin opacity, sin transiciones.
  function setState(s: 'initial' | 'results' | 'empty') {
    stInitial.style.display = 'none';
    stResults.style.display = 'none';
    stEmpty.style.display   = 'none';
    if      (s === 'initial') stInitial.style.display = 'block';
    else if (s === 'results') stResults.style.display = 'block';
    else                      stEmpty.style.display   = 'flex';
  }

  // ── Actualizar vista ──────────────────────────
  function refresh() {
    const q = input.value.trim();

    // Sincronizar URL: F5 siempre restaura el estado actual, no el inicial
    const newUrl = q
      ? `${window.location.pathname}?q=${encodeURIComponent(q)}`
      : window.location.pathname;
    history.replaceState(null, '', newUrl);

    // Sin texto y sin filtro → estado inicial con todos los artículos
    if (!q && !activeCategory) {
      initialGrid.innerHTML = allArticles.map(a => renderCard(a)).join('');
      setState('initial');
      return;
    }

    // Calcular artículos filtrados
    let filtered: Article[];
    if (q) {
      filtered = fuse.search(q).map(r => r.item);
      if (activeCategory) filtered = filtered.filter(a => a.categoria === activeCategory);
    } else {
      filtered = allArticles.filter(a => a.categoria === activeCategory);
    }

    if (filtered.length === 0) {
      emptyTerm.textContent = q ? `"${q}"` : catLabel(activeCategory);
      setState('empty');
    } else {
      const n = filtered.length;
      resultsMeta.textContent = q
        ? `${n} ${n === 1 ? 'resultado' : 'resultados'} para "${q}"`
        : `${n} ${n === 1 ? 'análisis' : 'análisis'} en ${catLabel(activeCategory)}`;
      resultsGrid.innerHTML = filtered.map(a => renderCard(a, q)).join('');
      setState('results');
    }
  }

  // ── Bootstrap ─────────────────────────────────
  fetch(indexUrl)
    .then(r => r.json())
    .then((data: Article[]) => {
      allArticles = data;
      fuse = new Fuse(allArticles, {
        keys: [
          { name: 'title',       weight: 0.6 },
          { name: 'descripcion', weight: 0.3 },
          { name: 'categoria',   weight: 0.1 },
        ],
        threshold: 0.3,
        includeMatches: true,
        minMatchCharLength: 2,
      });

      const params = new URLSearchParams(window.location.search);
      const q = params.get('q') ?? '';
      if (q) { input.value = q; clearBtn.hidden = false; }
      refresh();
    })
    .catch(() => {
      stInitial.style.display = 'block';
      initialGrid.innerHTML = '<p style="color:#6B7280;padding:2rem 0">Error al cargar el índice.</p>';
    });

  // ── Eventos ───────────────────────────────────
  let debounceTimer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearBtn.hidden = !input.value;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(refresh, 200);
  });

  clearBtn.addEventListener('click', () => {
    input.value = '';
    clearBtn.hidden = true;
    input.focus();
    refresh();
  });

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCategory = btn.dataset.cat ?? '';
      refresh();
    });
  });
</script>

<style>
  /* ===== HERO ===== */
  .search-hero {
    background: linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
    padding: 3rem 0 1.75rem;
  }

  .search-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .search-hero-text h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .search-hero-text p {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  /* ===== SEARCH BOX ===== */
  .search-box {
    width: 100%;
    max-width: 640px;
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    width: 20px;
    height: 20px;
    color: var(--color-text-muted);
    pointer-events: none;
    flex-shrink: 0;
  }

  #search-input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text);
    background: white;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0.9rem 3rem 0.9rem 3rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  #search-input:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 4px rgba(249,115,22,0.12), 0 4px 16px rgba(0,0,0,0.08);
    transform: scale(1.01);
  }

  #search-input::placeholder { color: var(--color-text-muted); }

  .clear-btn {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: background 0.15s, color 0.15s;
  }

  .clear-btn:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text);
  }

  .clear-btn svg { width: 16px; height: 16px; }

  /* ===== FILTERS ===== */
  .category-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .filter-btn {
    background: white;
    border: 1.5px solid var(--color-border);
    border-radius: 2rem;
    padding: 0.4rem 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.15s;
  }

  .filter-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
    background: var(--color-brand-bg);
  }

  .filter-btn.active {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: white;
  }

  /* ===== STATES SECTION ===== */
  .search-results-section {
    padding: 1.5rem 0 5rem;
  }

  .section-label {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }

  .results-meta {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  /* ===== ARTICLE CARDS ===== */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
  }

  .article-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
    animation: fadeUp 0.25s ease both;
  }

  .article-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .card-link:hover { text-decoration: none; color: inherit; }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .article-card:hover .card-img-wrap img { transform: scale(1.04); }

  .card-badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--color-brand);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 2rem;
  }

  .card-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-title {
    font-size: 0.975rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
  }

  .card-desc {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .card-score {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .card-tipo-badge {
    font-size: 0.72rem;
    font-weight: 700;
    background: #FEF3C7;
    color: #92400E;
    padding: 0.2rem 0.55rem;
    border-radius: 2rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-sep {
    color: #9CA3AF;
    font-size: 0.85rem;
    line-height: 1;
  }

  .card-price {
    font-size: 0.85rem;
    color: #6B7280;
    font-weight: 500;
  }

  mark {
    background: rgba(249,115,22,0.18);
    color: #EA580C;
    border-radius: 2px;
    padding: 0 1px;
  }

  /* ===== EMPTY STATE ===== */
  /* display:flex se aplica solo vía JS (stEmpty.style.display = 'flex') */
  #state-empty {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1rem;
  }

  .empty-fitz svg { width: 110px; height: 130px; }

  .empty-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1F2937;
    margin: 0;
  }

  #empty-term {
    color: #F97316;
    font-weight: 700;
  }

  .empty-sub {
    font-size: 0.9375rem;
    color: #6B7280;
    margin: 0;
  }

  .empty-cats {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .empty-cats a {
    padding: 0.4rem 1rem;
    border: 1.5px solid #F97316;
    border-radius: 2rem;
    color: #F97316;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .empty-cats a:hover {
    background: #F97316;
    color: white;
    text-decoration: none;
  }

  /* ===== A11Y ===== */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .search-hero { padding: 2rem 0 1.75rem; }
    #search-input { font-size: 1rem; }
    .articles-grid { grid-template-columns: 1fr; }
  }
</style>
