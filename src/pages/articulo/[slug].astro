---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import ScoreBox from '../../components/ScoreBox.astro';
import SpecsTable from '../../components/SpecsTable.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import FitzQuote from '../../components/FitzQuote.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { u, base } from '../../lib/url';
import { scoreColor } from '../../lib/score';

export async function getStaticPaths() {
  const articles = (await getCollection('articulos')).filter(a => !a.data.borrador);
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articulos'>;
}

const { article } = Astro.props;
const { Content } = await article.render();
const { title, fecha, categoria, descripcion, imagen, puntuacion, precio, enlace_afiliado, tiempo_lectura, fitzQuote, especificaciones, tipo, precio_oferta, precio_normal, descuento, oferta_activa } = article.data;
const esOferta = tipo === 'oferta';
const precioMostrado = esOferta && precio_oferta ? precio_oferta : precio;

const fechaFormateada = new Date(fecha).toLocaleDateString('es-ES', {
  year: 'numeric', month: 'long', day: 'numeric',
});

// Construir URL de búsqueda en Google Shopping desde el nombre del producto
const productName = title.split(':')[0].trim();
const pcSearchUrl = `https://www.google.com/search?q=${encodeURIComponent(productName)}&tbm=shop`;

const allArticles = (await getCollection('articulos')).filter(a => !a.data.borrador);
const related = allArticles
  .filter(a => a.data.categoria === categoria && a.slug !== article.slug)
  .slice(0, 3);

// Review schema solo para análisis con puntuación numérica.
// Google exige offers en itemReviewed para enriquecer resultados.
const precioLimpio = precio ? precio.replace(/[€\s]/g, '').replace(',', '.') : null;
const esAnalisisConPuntuacion = tipo === 'analisis' && typeof puntuacion === 'number';

const reviewSchema = esAnalisisConPuntuacion ? {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: title,
  reviewBody: descripcion,
  itemReviewed: {
    '@type': 'Product',
    name: productName,
    image: `https://fitzdesk.com${imagen}`,
    description: descripcion,
    ...(precioLimpio && {
      offers: {
        '@type': 'Offer',
        price: precioLimpio,
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
      },
    }),
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: puntuacion,
    bestRating: '10',
    worstRating: '0',
  },
  author: { '@type': 'Organization', name: 'FitzDesk' },
  datePublished: fecha,
  url: Astro.url.href,
} : {
  '@context': 'https://schema.org',
  '@type': 'Article',
  name: title,
  headline: title,
  description: descripcion,
  author: { '@type': 'Organization', name: 'FitzDesk' },
  datePublished: fecha,
  url: Astro.url.href,
};
---

<BaseLayout
  title={title}
  description={descripcion}
  image={imagen}
  type="article"
  schema={reviewSchema}
>
  <article class="article-page">
    <div class="article-hero">
      <img
        src={u(imagen)}
        alt={title}
        width="1200"
        height="630"
        loading="eager"
        decoding="async"
      />
      <div class="hero-overlay">
        <div class="container">
          <nav class="breadcrumb breadcrumb-hero" aria-label="Ruta de navegación">
            <a href={base}>Inicio</a>
            <span class="breadcrumb-sep" aria-hidden="true">›</span>
            <a href={u(`/categoria/${categoria}`)}>
              {categoria.charAt(0).toUpperCase() + categoria.slice(1)}
            </a>
          </nav>
          <CategoryBadge categoria={categoria} size="md" />
          <h1 class="hero-title">{title}</h1>
          <div class="hero-meta">
            <time datetime={fecha}>{fechaFormateada}</time>
            {tiempo_lectura && <span>· {tiempo_lectura} de lectura</span>}
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="article-layout">
        <main class="article-main">
          <p class="article-lead">{descripcion}</p>

          {puntuacion && <ScoreBox puntuacion={puntuacion} precio={precio} />}

          <AffiliateButton href={pcSearchUrl} precio={precio} />

          {fitzQuote && <FitzQuote quote={fitzQuote} />}

          <div class="prose">
            <Content />
          </div>

          {especificaciones && Object.keys(especificaciones).length > 0 && (
            <SpecsTable especificaciones={especificaciones} />
          )}

          <AffiliateButton href={pcSearchUrl} precio={precio} />
        </main>

        <aside class="article-sidebar">
          {puntuacion && (
            <div class="sidebar-card">
              <h3>Puntuación</h3>
              <div class="sidebar-score" style={`color: ${scoreColor(puntuacion)}`}>
                {puntuacion}<span>/10</span>
              </div>
            </div>
          )}

          {precioMostrado && (
            <div class="sidebar-card">
              <h3>Precio</h3>
              <div class="sidebar-price-row">
                {esOferta && precio_normal && (
                  <span class="sidebar-price-tachado">{precio_normal}</span>
                )}
                <p class="sidebar-price">{precioMostrado}</p>
                {esOferta && (
                  <span class={`sidebar-oferta-badge ${oferta_activa === false ? 'finalizada' : 'activa'}`}>
                    {oferta_activa === false ? 'Oferta finalizada' : '🔥 En oferta'}
                  </span>
                )}
              </div>
              {esOferta && descuento && oferta_activa !== false && (
                <p class="sidebar-descuento">Ahorras un {descuento.replace(/^-/, '')}</p>
              )}
              <a href={pcSearchUrl} target="_blank" rel="noopener noreferrer" class="sidebar-btn">
                Ver precio actual →
              </a>
            </div>
          )}

          {especificaciones && Object.keys(especificaciones).length > 0 && (
            <div class="sidebar-card sidebar-specs">
              <h3>Specs rápidas</h3>
              <dl>
                {Object.entries(especificaciones).slice(0, 5).map(([k, v]) => (
                  <>
                    <dt>{k.replace(/_/g, ' ')}</dt>
                    <dd>{v}</dd>
                  </>
                ))}
              </dl>
            </div>
          )}
        </aside>
      </div>

      {related.length > 0 && (
        <section class="related-section">
          <h2>Análisis relacionados</h2>
          <div class="articles-grid">
            {related.map(rel => (
              <ArticleCard
                title={rel.data.title}
                slug={rel.slug}
                categoria={rel.data.categoria}
                fecha={rel.data.fecha}
                descripcion={rel.data.descripcion}
                imagen={rel.data.imagen}
                puntuacion={rel.data.puntuacion}
                precio={rel.data.precio}
                tipo={rel.data.tipo}
                precio_oferta={rel.data.precio_oferta}
                precio_normal={rel.data.precio_normal}
                descuento={rel.data.descuento}
                oferta_activa={rel.data.oferta_activa}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .article-hero {
    position: relative;
    width: 100%;
    min-height: 380px;
    max-height: 560px;
    overflow: hidden;
    background: var(--color-bg-tertiary);
  }

  .article-hero img {
    width: 100%;
    height: 100%;
    max-height: 560px;
    object-fit: cover;
    display: block;
  }

  .hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 55%, transparent 100%);
    padding: 3rem 0 2rem;
    color: white;
  }

  .breadcrumb-hero {
    color: rgba(255,255,255,0.7);
    margin-bottom: 0.75rem;
  }

  .breadcrumb-hero a {
    color: rgba(255,255,255,0.7);
  }

  .breadcrumb-hero a:hover {
    color: white;
  }

  .breadcrumb-hero .breadcrumb-sep {
    color: rgba(255,255,255,0.4);
  }

  .hero-title {
    font-size: clamp(1.4rem, 4vw, 2.25rem);
    line-height: 1.2;
    color: white;
    margin: 0.6rem 0 0.5rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
    max-width: 820px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.75);
    margin-top: 0.35rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    padding: 2.5rem 0 4rem;
    align-items: start;
  }

  .article-lead {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .sidebar-card h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .sidebar-score {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
  }

  .sidebar-score span { font-size: 1.25rem; opacity: 0.6; }

  .sidebar-price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .sidebar-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .sidebar-price-tachado {
    font-size: 1rem;
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .sidebar-oferta-badge {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .sidebar-oferta-badge.activa {
    background: var(--color-brand);
    color: white;
  }

  .sidebar-oferta-badge.finalizada {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .sidebar-descuento {
    font-size: 0.85rem;
    color: var(--color-success);
    font-weight: 600;
    margin: 0 0 0.75rem;
  }

  .sidebar-btn {
    display: block;
    background: var(--color-brand);
    color: white;
    text-align: center;
    padding: 0.65rem 1rem;
    border-radius: var(--radius);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition);
  }

  .sidebar-btn:hover {
    background: var(--color-brand-dark);
    text-decoration: none;
    color: white;
  }

  .sidebar-specs dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.75rem;
  }

  .sidebar-specs dt { font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); white-space: nowrap; }
  .sidebar-specs dd { font-size: 0.8rem; color: var(--color-text); }

  .related-section {
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--color-border);
  }

  .related-section h2 { font-size: 1.5rem; margin-bottom: 1.75rem; }

  @media (max-width: 900px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
</style>
