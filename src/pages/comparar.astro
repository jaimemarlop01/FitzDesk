---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { u } from '../lib/url';

const allArticles = await getCollection('articulos');

type ArticleItem = {
  slug: string;
  title: string;
  categoria: string;
  imagen: string;
  puntuacion: number;
  precio: string;
  enlace_afiliado: string;
  criterios: Record<string, number>;
};

const comparables: ArticleItem[] = allArticles
  .filter(a => !a.data.borrador && a.data.tipo === 'analisis' && a.data.puntuacion != null)
  .map(a => ({
    slug: a.slug,
    title: a.data.title,
    categoria: a.data.categoria,
    imagen: u(a.data.imagen),
    puntuacion: a.data.puntuacion as number,
    precio: a.data.precio ?? 'Ver precio',
    enlace_afiliado: a.data.enlace_afiliado ?? '',
    criterios: (a.data.criterios as Record<string, number>) ?? {},
  }));

const byCategory: Record<string, ArticleItem[]> = {};
for (const art of comparables) {
  if (!byCategory[art.categoria]) byCategory[art.categoria] = [];
  byCategory[art.categoria].push(art);
}

const CAT_ORDER = ['ratones', 'teclados', 'monitores', 'portatiles', 'setups'];
const CAT_LABELS: Record<string, string> = {
  ratones: 'Ratones', teclados: 'Teclados', monitores: 'Monitores',
  portatiles: 'Portátiles', setups: 'Setups',
};
const validCats = CAT_ORDER.filter(c => (byCategory[c]?.length ?? 0) >= 2);

const dataJson = JSON.stringify({ byCategory, validCats, catLabels: CAT_LABELS });
---

<BaseLayout
  title="Comparar periféricos para teletrabajo — FitzDesk"
  description="Compara ratones, teclados, monitores y portátiles para teletrabajo lado a lado. Gráfico de radar y tabla comparativa instantánea."
>
  <Fragment slot="head">
    <script defer src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js" integrity="sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ" crossorigin="anonymous"></script>
    <script type="application/json" id="comparar-data" set:html={dataJson}></script>
  </Fragment>

  <!-- HERO -->
  <section class="comparar-hero">
    <div class="container hero-inner">
      <div>
        <h1>Compara periféricos <em>lado a lado</em></h1>
        <p class="hero-lead">Elige dos productos y obtén una comparativa instantánea con gráfico de radar y tabla detallada.</p>
      </div>
    </div>
  </section>

  <!-- PASO A — Categorías -->
  <section class="comparar-section" id="step-cats">
    <div class="container">
      <div class="step-label"><span class="step-num">1</span> Elige una categoría</div>
      <div class="cat-pills" id="cat-pills" role="group" aria-label="Categorías disponibles"></div>
    </div>
  </section>

  <!-- PASO B — Productos -->
  <section class="comparar-section" id="step-products" hidden>
    <div class="container">
      <div class="step-label"><span class="step-num">2</span> Selecciona 2 productos</div>

      <!-- MEJORA 2 — Indicador de selección -->
      <div class="selection-indicator" id="selection-indicator">
        <p class="sel-empty-msg" id="sel-empty-msg">Selecciona 2 productos para comparar</p>
        <div class="sel-slots" id="sel-slots" hidden>
          <div class="sel-slot" id="sel-slot-a"></div>
          <div class="sel-slot" id="sel-slot-b"></div>
        </div>
      </div>

      <!-- MEJORA 3 — Buscador de productos -->
      <div class="product-search" id="product-search">
        <div class="ps-input-wrap">
          <svg class="ps-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <input type="search" id="ps-input" placeholder="Buscar producto..." autocomplete="off" aria-label="Buscar producto en esta categoría">
          <button id="ps-clear" class="ps-clear" aria-label="Limpiar búsqueda" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="products-grid" id="products-grid" role="list"></div>

      <div class="search-empty" id="search-empty" hidden>
        <p>🐿️ Fitz no encuentra ningún producto con ese nombre en esta categoría</p>
      </div>

      <div class="compare-cta">
        <button class="btn-compare" id="btn-compare" disabled aria-disabled="true">
          Comparar →
        </button>
      </div>
    </div>
  </section>

  <!-- PASO C — Resultado -->
  <section class="comparar-result" id="step-compare" hidden>
    <div class="container">
      <div class="result-topbar">
        <h2 class="compare-vs-title" id="compare-title">vs</h2>
        <button class="btn-back" id="btn-back">← Cambiar productos</button>
      </div>

      <div class="compare-heads" id="compare-heads"></div>

      <div class="compare-body">
        <div class="radar-wrap">
          <canvas id="radar-chart" role="img" aria-label="Gráfico radar de comparativa"></canvas>
          <div class="radar-legend" id="radar-legend"></div>
        </div>
        <div class="table-wrap">
          <table class="compare-table" id="compare-table">
            <thead><tr><th>Criterio</th><th id="th-a">Producto A</th><th id="th-b">Producto B</th></tr></thead>
            <tbody id="compare-tbody"></tbody>
          </table>
        </div>
      </div>

      <div class="recommendation" id="recommendation"></div>
      <div class="afiliado-btns" id="afiliado-btns"></div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function () {
  /* ── DATA ── */
  var DATA = JSON.parse(document.getElementById('comparar-data').textContent);
  var byCategory = DATA.byCategory;
  var validCats  = DATA.validCats;
  var catLabels  = DATA.catLabels;

  /* ── CRITERIA — label (display) + key (frontmatter) ── */
  var CRITERIA = {
    ratones:   [
      { label: 'Ergonomía',      key: 'ergonomia'      },
      { label: 'Precisión',      key: 'precision'      },
      { label: 'Autonomía',      key: 'autonomia'      },
      { label: 'Conectividad',   key: 'conectividad'   },
      { label: 'Calidad/Precio', key: 'calidad_precio' },
    ],
    teclados:  [
      { label: 'Tacto',          key: 'tacto'          },
      { label: 'Silencio',       key: 'ruido'          },
      { label: 'Conectividad',   key: 'conectividad'   },
      { label: 'Durabilidad',    key: 'durabilidad'    },
      { label: 'Calidad/Precio', key: 'calidad_precio' },
    ],
    monitores: [
      { label: 'Calidad imagen',   key: 'calidad_imagen'    },
      { label: 'Ergonomía soporte',key: 'ergonomia_soporte' },
      { label: 'Conectividad',     key: 'conectividad'      },
      { label: 'Cuidado ocular',   key: 'cuidado_ocular'    },
      { label: 'Calidad/Precio',   key: 'calidad_precio'    },
    ],
    portatiles:[
      { label: 'Rendimiento',      key: 'rendimiento'    },
      { label: 'Batería',          key: 'bateria'        },
      { label: 'Pantalla',         key: 'pantalla'       },
      { label: 'Teclado/Trackpad', key: 'teclado_trackpad'},
      { label: 'Calidad/Precio',   key: 'calidad_precio' },
    ],
    setups:    [
      { label: 'Construcción',   key: 'construccion'   },
      { label: 'Facilidad uso',  key: 'facilidad_uso'  },
      { label: 'Compatibilidad', key: 'compatibilidad' },
      { label: 'Sonido/Imagen',  key: 'sonido_imagen'  },
      { label: 'Calidad/Precio', key: 'calidad_precio' },
    ],
  };

  var CAT_SEARCH_TEXT = {
    ratones:   'un ratón cómodo y preciso',
    teclados:  'el mejor teclado para tu flujo de trabajo',
    monitores: 'una pantalla para trabajar durante horas',
    portatiles:'potencia y portabilidad en un portátil',
    setups:    'mejorar tu setup de teletrabajo',
  };

  /* ── CHART COLORS (JS constants: Chart.js no acepta CSS vars) ── */
  var CHART_A_FILL   = 'rgba(249,115,22,0.25)';
  var CHART_A_STROKE = 'rgba(249,115,22,0.9)';
  var CHART_B_FILL   = 'rgba(59,130,246,0.2)';
  var CHART_B_STROKE = 'rgba(59,130,246,0.85)';

  /* ── STATE ── */
  var selectedCat = null;
  var selA = null;
  var selB = null;
  var radarChart = null;

  /* ── SCORE ── */
  function hashSeed(str) {
    var h = 0;
    for (var i = 0; i < str.length; i++) h = (Math.imul(31, h) + str.charCodeAt(i)) | 0;
    return Math.abs(h);
  }

  function priceScore(priceStr) {
    var p = parseFloat((priceStr || '').replace(/[^0-9,.]/g, '').replace(',', '.'));
    if (isNaN(p)) return 7;
    if (p < 50)  return 9.5;
    if (p < 100) return 8.5;
    if (p < 200) return 7;
    if (p < 400) return 6;
    return 5;
  }

  function criteriaScores(article, cat) {
    var criteria = CRITERIA[cat] || [];
    var crits    = article.criterios || {};
    return criteria.map(function(c, i) {
      if (crits[c.key] !== undefined) return crits[c.key];
      // Fallback derivado si no hay dato real
      var base = article.puntuacion;
      if (i === criteria.length - 1) {
        var ps = priceScore(article.precio);
        return +((base * 0.55 + ps * 0.45).toFixed(1));
      }
      var seed      = hashSeed(article.slug + ':' + i);
      var variation = ((seed % 31) - 15) / 10;
      return Math.max(1, Math.min(10, +(base + variation).toFixed(1)));
    });
  }

  /* ── DOM REFS ── */
  var stepProducts    = document.getElementById('step-products');
  var stepCompare     = document.getElementById('step-compare');
  var catPills        = document.getElementById('cat-pills');
  var productsGrid    = document.getElementById('products-grid');
  var btnCompare      = document.getElementById('btn-compare');
  var btnBack         = document.getElementById('btn-back');
  var selEmptyMsg     = document.getElementById('sel-empty-msg');
  var selSlots        = document.getElementById('sel-slots');
  var selSlotA        = document.getElementById('sel-slot-a');
  var selSlotB        = document.getElementById('sel-slot-b');
  var psInput         = document.getElementById('ps-input');
  var psClear         = document.getElementById('ps-clear');
  var searchEmpty     = document.getElementById('search-empty');
  var compareTitle    = document.getElementById('compare-title');
  var compareHeads    = document.getElementById('compare-heads');
  var compareTbody    = document.getElementById('compare-tbody');
  var thA             = document.getElementById('th-a');
  var thB             = document.getElementById('th-b');
  var recommendation  = document.getElementById('recommendation');
  var afiliadoBtns    = document.getElementById('afiliado-btns');
  var radarLegend     = document.getElementById('radar-legend');

  /* ── RENDER PILLS ── */
  validCats.forEach(function(cat) {
    var btn = document.createElement('button');
    btn.className = 'cat-pill';
    btn.textContent = catLabels[cat] || cat;
    btn.dataset.cat = cat;
    btn.addEventListener('click', function() { selectCat(cat); });
    catPills.appendChild(btn);
  });

  /* ── SELECT CATEGORY ── */
  function selectCat(cat) {
    selectedCat = cat;
    selA = null;
    selB = null;

    catPills.querySelectorAll('.cat-pill').forEach(function(p) {
      p.classList.toggle('active', p.dataset.cat === cat);
    });

    resetSearch();
    renderProducts(cat);
    updateSelectionIndicator();
    updateCompareBtn();

    stepProducts.hidden = false;
    stepCompare.hidden  = true;
    stepProducts.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  /* ── RENDER PRODUCTS ── */
  function renderProducts(cat) {
    var articles = byCategory[cat] || [];
    productsGrid.innerHTML = '';
    articles.forEach(function(art) {
      var card = document.createElement('div');
      card.className = 'product-card';
      card.dataset.slug = art.slug;
      card.setAttribute('role', 'listitem');
      card.innerHTML =
        '<div class="pc-img"><img src="' + esc(art.imagen) + '" alt="' + esc(art.title) + '" loading="lazy" width="320" height="180"></div>' +
        '<div class="pc-body">' +
          '<p class="pc-title">' + esc(art.title) + '</p>' +
          (art.puntuacion != null ? '<p class="pc-score">' + art.puntuacion + '/10</p>' : '') +
          (art.precio ? '<p class="pc-price">' + esc(art.precio) + '</p>' : '') +
        '</div>';
      card.addEventListener('click', function() { toggleProduct(art.slug); });
      productsGrid.appendChild(card);
    });
  }

  /* ── TOGGLE PRODUCT ── */
  function toggleProduct(slug) {
    if      (selA === slug) { selA = null; }
    else if (selB === slug) { selB = null; }
    else if (selA == null)  { selA = slug; }
    else if (selB == null)  { selB = slug; }
    else                    { selA = selB; selB = slug; }

    productsGrid.querySelectorAll('.product-card').forEach(function(c) {
      var s = c.dataset.slug;
      c.classList.remove('sel-a', 'sel-b');
      if (s === selA) c.classList.add('sel-a');
      if (s === selB) c.classList.add('sel-b');
    });
    updateSelectionIndicator();
    updateCompareBtn();
  }

  /* ── MEJORA 2: SELECTION INDICATOR ── */
  function updateSelectionIndicator() {
    var count = (selA ? 1 : 0) + (selB ? 1 : 0);

    if (count === 0) {
      selEmptyMsg.hidden = false;
      selSlots.hidden    = true;
      return;
    }

    selEmptyMsg.hidden = true;
    selSlots.hidden    = false;

    var artA = selA ? findArticle(selA) : null;
    var artB = selB ? findArticle(selB) : null;
    renderSlot(selSlotA, artA, 'a');
    renderSlot(selSlotB, artB, 'b');
  }

  function renderSlot(container, art, slot) {
    container.innerHTML = '';
    var div = document.createElement('div');

    if (art) {
      div.className = 'sel-filled sel-filled-' + slot;

      var img = document.createElement('img');
      img.src       = art.imagen;
      img.alt       = '';
      img.className = 'sel-thumb';

      var nameSpan = document.createElement('span');
      nameSpan.className   = 'sel-name';
      nameSpan.textContent = shortTitle(art.title);

      var removeBtn = document.createElement('button');
      removeBtn.className = 'sel-remove';
      removeBtn.setAttribute('aria-label', 'Quitar ' + shortTitle(art.title));
      removeBtn.textContent = '×';
      var capturedSlug = art.slug;
      removeBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleProduct(capturedSlug);
      });

      div.appendChild(img);
      div.appendChild(nameSpan);
      div.appendChild(removeBtn);
    } else {
      div.className = 'sel-empty-slot';
      var plus = document.createElement('span');
      plus.className   = 'sel-plus';
      plus.textContent = '+';
      var label = document.createElement('span');
      label.textContent = 'Elige el segundo';
      div.appendChild(plus);
      div.appendChild(label);
    }

    container.appendChild(div);
  }

  /* ── UPDATE COMPARE BUTTON ── */
  function updateCompareBtn() {
    var ready = selA != null && selB != null;
    btnCompare.disabled = !ready;
    btnCompare.setAttribute('aria-disabled', String(!ready));

    if (ready) {
      var artA = findArticle(selA);
      var artB = findArticle(selB);
      if (artA && artB) {
        btnCompare.textContent = 'Comparar ' + shortTitle(artA.title) + ' vs ' + shortTitle(artB.title);
      } else {
        btnCompare.textContent = 'Comparar →';
      }
    } else {
      btnCompare.textContent = 'Comparar →';
    }
  }

  /* ── MEJORA 3: BUSCADOR ── */
  psInput.addEventListener('input', function() {
    var q = this.value.trim();
    psClear.hidden = q === '';
    filterProducts(q);
  });

  psClear.addEventListener('click', function() {
    psInput.value  = '';
    psClear.hidden = true;
    filterProducts('');
    psInput.focus();
  });

  function filterProducts(query) {
    var q       = query.toLowerCase();
    var cards   = productsGrid.querySelectorAll('.product-card');
    var visible = 0;
    cards.forEach(function(card) {
      var titleEl = card.querySelector('.pc-title');
      var title   = titleEl ? titleEl.textContent : '';
      var show    = !q || title.toLowerCase().indexOf(q) !== -1;
      card.hidden = !show;
      if (show) visible++;
    });
    searchEmpty.hidden = visible > 0;
  }

  function resetSearch() {
    if (psInput)    { psInput.value = ''; }
    if (psClear)    { psClear.hidden = true; }
    if (searchEmpty){ searchEmpty.hidden = true; }
    productsGrid.querySelectorAll('.product-card').forEach(function(c) { c.hidden = false; });
  }

  /* ── COMPARE ── */
  btnCompare.addEventListener('click', function() {
    if (!selA || !selB) return;
    var artA = findArticle(selA);
    var artB = findArticle(selB);
    if (!artA || !artB) return;
    showComparison(artA, artB);
  });

  btnBack.addEventListener('click', function() {
    stepCompare.hidden  = true;
    stepProducts.hidden = false;
    stepProducts.scrollIntoView({ behavior: 'smooth', block: 'start' });
    history.replaceState(null, '', location.pathname);
    document.title = 'Comparar periféricos para teletrabajo — FitzDesk';
  });

  function findArticle(slug) {
    var arts = byCategory[selectedCat] || [];
    return arts.find(function(a) { return a.slug === slug; }) || null;
  }

  /* ── SHOW COMPARISON ── */
  function showComparison(artA, artB) {
    var cat      = selectedCat;
    var criteria = CRITERIA[cat] || [];
    var scoresA  = criteriaScores(artA, cat);
    var scoresB  = criteriaScores(artB, cat);

    var vsTitle = shortTitle(artA.title) + ' vs ' + shortTitle(artB.title);
    compareTitle.textContent = vsTitle;
    document.title = vsTitle + ' — FitzDesk';
    updateURL(artA.slug, artB.slug);

    compareHeads.innerHTML =
      headCard(artA, true) +
      '<div class="vs-badge">VS</div>' +
      headCard(artB, false);

    thA.textContent = shortTitle(artA.title);
    thB.textContent = shortTitle(artB.title);

    compareTbody.innerHTML = '';
    compareTbody.innerHTML += tableRow('Puntuación general',
      artA.puntuacion + '/10', artB.puntuacion + '/10',
      artA.puntuacion > artB.puntuacion + 0.5 ? 'a' :
      artB.puntuacion > artA.puntuacion + 0.5 ? 'b' : 'tie');

    criteria.forEach(function(c, i) {
      var sA     = scoresA[i], sB = scoresB[i];
      var winner = sA > sB + 0.5 ? 'a' : sB > sA + 0.5 ? 'b' : 'tie';
      compareTbody.innerHTML += tableRow(c.label, sA.toFixed(1), sB.toFixed(1), winner);
    });

    renderRadar(artA, artB, criteria, scoresA, scoresB);

    radarLegend.innerHTML =
      '<span class="leg-a"><span class="leg-dot leg-dot-a"></span>' + esc(shortTitle(artA.title)) + '</span>' +
      '<span class="leg-b"><span class="leg-dot leg-dot-b"></span>' + esc(shortTitle(artB.title)) + '</span>';

    renderRecommendation(artA, artB, cat);
    renderAfiliadoBtns(artA, artB);

    stepProducts.hidden = true;
    stepCompare.hidden  = false;
    stepCompare.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function headCard(art, isA) {
    var scoreClass = isA ? 'head-score-a' : 'head-score-b';
    return '<div class="head-card">' +
      '<div class="head-img"><img src="' + esc(art.imagen) + '" alt="' + esc(art.title) + '" loading="lazy"></div>' +
      '<h3 class="head-title">' + esc(art.title) + '</h3>' +
      '<p class="head-score ' + scoreClass + '">' + (art.puntuacion != null ? art.puntuacion + '/10' : '') + '</p>' +
      '<p class="head-price">' + esc(art.precio) + '</p>' +
    '</div>';
  }

  function tableRow(label, valA, valB, winner) {
    var iconA = winner === 'a' ? '✅' : winner === 'tie' ? '⚠️' : '❌';
    var iconB = winner === 'b' ? '✅' : winner === 'tie' ? '⚠️' : '❌';
    return '<tr><td class="crit-label">' + esc(label) + '</td>' +
      '<td class="crit-val val-a">' + iconA + ' ' + valA + '</td>' +
      '<td class="crit-val val-b">' + iconB + ' ' + valB + '</td></tr>';
  }

  function renderRecommendation(artA, artB, cat) {
    var diff       = artA.puntuacion - artB.puntuacion;
    var searchText = CAT_SEARCH_TEXT[cat] || 'el mejor producto';
    var text;
    if (diff > 0.5) {
      text = 'Si buscas ' + searchText + ', <strong>' + esc(shortTitle(artA.title)) + '</strong> es la mejor opción con ' + artA.puntuacion + '/10 frente a ' + artB.puntuacion + '/10.';
    } else if (diff < -0.5) {
      text = 'Si buscas ' + searchText + ', <strong>' + esc(shortTitle(artB.title)) + '</strong> es la mejor opción con ' + artB.puntuacion + '/10 frente a ' + artA.puntuacion + '/10.';
    } else {
      var cheaper = parsePrice(artA.precio) < parsePrice(artB.precio) ? shortTitle(artA.title) : shortTitle(artB.title);
      text = 'Ambos son excelentes opciones con puntuaciones muy similares. La diferencia principal está en el precio — <strong>' + esc(cheaper) + '</strong> es la opción más económica.';
    }
    recommendation.innerHTML = '<div class="rec-inner"><span class="rec-fitz">🐿️</span><p>' + text + '</p></div>';
  }

  function renderAfiliadoBtns(artA, artB) {
    afiliadoBtns.innerHTML = '';
    [artA, artB].forEach(function(art, i) {
      if (!art.enlace_afiliado) return;
      var cls = i === 0 ? 'btn-aff-a' : 'btn-aff-b';
      var a   = document.createElement('a');
      a.href  = art.enlace_afiliado;
      a.target    = '_blank';
      a.rel       = 'noopener noreferrer sponsored';
      a.className = 'btn-aff ' + cls;
      a.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="width:18px;height:18px;flex-shrink:0">' +
          '<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>' +
          '<line x1="3" y1="6" x2="21" y2="6"/>' +
          '<path d="M16 10a4 4 0 01-8 0"/>' +
        '</svg>' +
        'Ver precio actual' +
        (art.precio ? '<span class="btn-aff-price">' + esc(art.precio) + '</span>' : '');
      afiliadoBtns.appendChild(a);
    });
  }

  /* ── RADAR ── */
  function renderRadar(artA, artB, criteria, scoresA, scoresB) {
    var canvas = document.getElementById('radar-chart');
    if (radarChart) { radarChart.destroy(); radarChart = null; }
    if (!window.Chart) return;
    radarChart = new window.Chart(canvas, {
      type: 'radar',
      data: {
        labels: criteria.map(function(c) { return c.label; }),
        datasets: [
          {
            label: shortTitle(artA.title),
            data: scoresA,
            backgroundColor: CHART_A_FILL,
            borderColor: CHART_A_STROKE,
            borderWidth: 2,
            pointBackgroundColor: CHART_A_STROKE,
            pointRadius: 4,
          },
          {
            label: shortTitle(artB.title),
            data: scoresB,
            backgroundColor: CHART_B_FILL,
            borderColor: CHART_B_STROKE,
            borderWidth: 2,
            pointBackgroundColor: CHART_B_STROKE,
            pointRadius: 4,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
          r: {
            min: 0, max: 10,
            ticks: { stepSize: 2, font: { size: 11 } },
            pointLabels: { font: { size: 12 } },
          },
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) { return ctx.dataset.label + ': ' + ctx.parsed.r + '/10'; },
            },
          },
        },
      },
    });
  }

  /* ── URL ── */
  function updateURL(slugA, slugB) {
    var url = new URL(location.href);
    url.searchParams.set('a', slugA);
    url.searchParams.set('b', slugB);
    history.replaceState(null, '', url.toString());
  }

  function loadFromURL() {
    var params = new URLSearchParams(location.search);
    var slugA  = params.get('a');
    var slugB  = params.get('b');
    if (!slugA || !slugB) return;

    var cat = null, artA = null, artB = null;
    Object.keys(byCategory).forEach(function(c) {
      var arts = byCategory[c];
      var a = arts.find(function(x) { return x.slug === slugA; });
      var b = arts.find(function(x) { return x.slug === slugB; });
      if (a && b) { cat = c; artA = a; artB = b; }
    });
    if (!cat || !artA || !artB) return;

    selectedCat = cat;
    selA = artA.slug;
    selB = artB.slug;
    selectCat(cat);

    setTimeout(function() {
      productsGrid.querySelectorAll('.product-card').forEach(function(c) {
        if (c.dataset.slug === selA) c.classList.add('sel-a');
        if (c.dataset.slug === selB) c.classList.add('sel-b');
      });
      updateSelectionIndicator();
      updateCompareBtn();
      showComparison(artA, artB);
    }, 50);
  }

  /* ── HELPERS ── */
  function esc(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function shortTitle(title) {
    return title.split(':')[0].trim();
  }

  function parsePrice(priceStr) {
    var p = parseFloat((priceStr || '').replace(/[^0-9,.]/g, '').replace(',', '.'));
    return isNaN(p) ? 9999 : p;
  }

  /* ── INIT ── */
  loadFromURL();
})();
</script>

