---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base, u } from '../lib/url';
---

<BaseLayout
  title="Error del servidor — FitzDesk"
  description="Algo ha salido mal en nuestro servidor. Inténtalo de nuevo en unos minutos."
>
  <div class="error-page">
    <div class="error-inner">
      <div class="error-fitz" aria-hidden="true">
        <svg viewBox="0 0 46 40" xmlns="http://www.w3.org/2000/svg" class="fitz-svg">
          <!-- Fitz squirrel face with startled expression -->
          <circle cx="20" cy="20" r="11" fill="#DEB887"/>
          <ellipse cx="12" cy="10" rx="4" ry="5.5" fill="#CD853F"/>
          <ellipse cx="28" cy="10" rx="4" ry="5.5" fill="#CD853F"/>
          <ellipse cx="20" cy="22" rx="7" ry="6" fill="#F4A460"/>
          <!-- Bigger whites = startled -->
          <circle cx="16" cy="18.5" r="3.2" fill="white"/>
          <circle cx="24" cy="18.5" r="3.2" fill="white"/>
          <!-- Bigger pupils = startled -->
          <circle cx="16.5" cy="18.5" r="2" fill="#1a1a1a"/>
          <circle cx="24.5" cy="18.5" r="2" fill="#1a1a1a"/>
          <!-- Glasses (slightly raised on face = eyebrows up) -->
          <rect x="11.5" y="15.5" width="8" height="5.5" rx="2" fill="none" stroke="#3d2b1f" stroke-width="1.2"/>
          <rect x="20.5" y="15.5" width="8" height="5.5" rx="2" fill="none" stroke="#3d2b1f" stroke-width="1.2"/>
          <line x1="19.5" y1="18.25" x2="20.5" y2="18.25" stroke="#3d2b1f" stroke-width="1.2"/>
          <ellipse cx="20" cy="24" rx="1.5" ry="1" fill="#8B4513"/>
          <polygon points="16.5,29 20,27 23.5,29 20,31" fill="#DC2626"/>
          <circle cx="20" cy="29" r="1.5" fill="#EF4444"/>
          <!-- Lightning bolt (error) -->
          <polygon points="37,6 33,18 37,18 33,32 41,16 37,16 41,6" fill="#F97316" opacity="0.85"/>
        </svg>
      </div>

      <div class="error-code" aria-hidden="true">500</div>
      <h1>Algo ha salido mal en nuestro servidor</h1>
      <p class="error-desc">
        Parece que Fitz ha roto algo. Inténtalo de nuevo en unos minutos.
      </p>

      <div class="error-actions">
        <a href={base} class="btn-primary">Volver a la home</a>
        <a href={u('/analisis')} class="btn-secondary">Explorar análisis</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    padding: 4rem 1rem;
  }

  .error-inner {
    text-align: center;
    max-width: 480px;
  }

  .error-fitz {
    margin-bottom: 1.5rem;
  }

  .fitz-svg {
    width: 140px;
    height: auto;
  }

  .error-code {
    font-size: clamp(4rem, 15vw, 7rem);
    font-weight: 900;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.15;
    margin-bottom: -1.5rem;
    font-family: var(--font-display);
  }

  h1 {
    font-size: clamp(1.4rem, 4vw, 1.875rem);
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .error-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: background var(--transition);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    text-decoration: none;
  }

  .btn-secondary {
    display: inline-block;
    color: var(--color-text-secondary);
    padding: 0.7rem 1.5rem;
    border-radius: 8px;
    font-weight: 500;
    text-decoration: none;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border);
    transition: border-color var(--transition), color var(--transition);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    text-decoration: none;
  }
</style>
